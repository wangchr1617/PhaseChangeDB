{
  "index_patterns": [
    "pcm-evidence-v1-*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "analysis": {
        "normalizer": {
          "lowercase_norm": {
            "type": "custom",
            "filter": [
              "lowercase"
            ]
          }
        }
      }
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "evidence_id": {
          "type": "keyword"
        },
        "paper_id": {
          "type": "keyword"
        },
        "document_id": {
          "type": "keyword"
        },
        "doi": {
          "type": "keyword",
          "normalizer": "lowercase_norm"
        },
        "fragment_type": {
          "type": "keyword"
        },
        "page_number": {
          "type": "integer"
        },
        "section": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "figure_number": {
          "type": "keyword"
        },
        "table_number": {
          "type": "keyword"
        },
        "text": {
          "type": "text"
        },
        "material_ids": {
          "type": "keyword"
        },
        "material_formulas": {
          "type": "keyword"
        },
        "property_codes": {
          "type": "keyword"
        },
        "verification_status": {
          "type": "keyword"
        },
        "embedding": {
          "type": "dense_vector",
          "dims": 1024,
          "similarity": "cosine",
          "index": true
        },
        "indexed_at": {
          "type": "date"
        }
      }
    }
  }
}
