# PhaseChangeDB 本地环境配置示例
PCM_APP_ENV=local
PCM_DATABASE_URL=mysql+asyncmy://phasechange:phasechange@127.0.0.1:3306/phasechangedb
PCM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PCM_REVIEWER_TOKEN=reviewer-token-dev-secret-2026
PCM_SECRET_KEY=phasechange-dev-secret-key-change-in-production-32b
# 官方大模型 API Key (混合双模托管额度，可选)
# PCM_GEMINI_API_KEY=your-gemini-api-key-here
# PCM_DEEPSEEK_API_KEY=your-deepseek-api-key-here
# Crossref Polite Pool 登记邮箱 (用于提升学术 API 配额)
PCM_CROSSREF_MAILTO=contact@phasechangedb.org
